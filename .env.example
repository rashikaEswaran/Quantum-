# QuantumTrace AI Configuration
APP_NAME="QuantumTrace AI"
APP_ENV=development
PORT=8000
HOST=0.0.0.0
DEBUG=true

# Database Configuration
# Defaults to SQLite for immediate local execution if Postgres is not configured
DATABASE_URL=sqlite:///./quantumtrace.db
# PostgreSQL alternative:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/quantumtrace

# IBM Quantum Integration
# Leave empty for offline simulation mode; provide actual token for live hardware access
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_INSTANCE=ibm-q/open/main

# AI / LLM Configuration
# Supports "mock", "openai", "anthropic", or "gemini"
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# BDH-CQ Reasoning Adapter
ENABLE_BDHCQ=true
BDHCQ_MODE=adaptive

# Simulation Settings
DEFAULT_SHOTS=2048
MAX_QUBITS=20
CIRCUIT_TIMEOUT_SECONDS=30

